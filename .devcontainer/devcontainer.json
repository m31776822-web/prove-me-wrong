{
  "name": "Prove Me Wrong",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Prove Me Wrong",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "npm start",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
